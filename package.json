{
  "name": "chronos-xxi",
  "version": "2.1.0",
  "private": true,
  "description": "CHRONOS XXI - E-commerce de relojes premium (HTML/CSS/JS vanilla) con integración continua",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --json --outputFile=reports/jest-results.json",
    "ci": "npm run lint && npm run test:ci",
    "smoke": "bash scripts/smoke-test.sh http://localhost:8080"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "eslint": "9.14.0",
    "globals": "15.12.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-junit": "16.0.0"
  }
}
