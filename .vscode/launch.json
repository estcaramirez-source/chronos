{
    // Entornos de depuración del proyecto (B1). Requiere `npm install`.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Depurar pruebas Jest del archivo abierto",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": ["--runInBand", "--watchAll=false", "${relativeFile}"],
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Depurar todas las pruebas Jest",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": ["--runInBand", "--watchAll=false"],
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Depurar la tienda en Edge (index.html)",
            "file": "${workspaceFolder}/PAGINA-WED-CHRONOS-XXI V2.1/index.html"
        }
    ]
}
